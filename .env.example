# Kopiér til .env og udfyld. .env må aldrig committes.
# Eksempel-toolet bruger ingen nøgler. Din egen server gør nok.

# Mappen med data, som serveren må læse (default: ./data)
# DATA_MAPPE=./data

# Nøgle til det API din server skal læse fra. Brug en nøgle med kun læseadgang.
# MIT_API_NOEGLE=

# Læser serveren fra faste adresser, så skriv dem her, adskilt med komma.
# Serveren må aldrig hente andre adresser end dem på listen.
# TILLADTE_ADRESSER=https://eksempel.dk/feed.xml
